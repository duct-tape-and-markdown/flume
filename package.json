{
  "name": "@dtmd/flume",
  "version": "0.10.0",
  "description": "A disciplined harness for AI-derivation pipelines. Disk-is-truth, stateless ticks, structured handoff, sandbox-optional.",
  "keywords": [
    "claude",
    "agents",
    "ai",
    "harness",
    "pipeline"
  ],
  "homepage": "https://github.com/duct-tape-and-markdown/flume#readme",
  "bugs": {
    "url": "https://github.com/duct-tape-and-markdown/flume/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duct-tape-and-markdown/flume.git"
  },
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "flume": "./bin/flume.js"
  },
  "scripts": {
    "flume": "./bin/flume.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --mode integration",
    "smoke:install": "node scripts/smoke-install.mjs",
    "changelog": "node scripts/build-changelog.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
